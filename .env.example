# Server-side secrets: never commit your real .env file.
GROQ_API_KEY=replace-with-your-groq-key
GITHUB_TOKEN=replace-with-your-github-token
PROXYCURL_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key

# For a remote deployment, set the externally visible URLs before `docker compose up --build`.
# VITE_API_URL=https://api.example.com
# NEXT_PUBLIC_RESUME_PARSER_URL=https://resume.example.com
# CORS_ORIGINS=https://resume.example.com,https://portal.example.com
